# Copiar a .env y completar. Nunca commitear .env.

# --- Postgres ---
DATABASE_URL=postgres://metasuite:changeme@postgres:5432/metasuite

# --- Auth del webhook Spoter → MetaSuite ---
# Bearer que Spoter usa en Authorization header
SPOTER_TO_METASUITE_BEARER=

# Secret separado para firmar HMAC-SHA256 del body (X-MetaSuite-Signature)
SPOTER_TO_METASUITE_SIGNING_SECRET=

# --- Meta MCP oficial ---
META_MCP_ENDPOINT=https://mcp.facebook.com/ads
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=
META_OAUTH_REFRESH_TOKEN=

# --- Surmotors (cliente piloto) ---
SURMOTORS_AD_ACCOUNT_ID=act_
SURMOTORS_DATASET_ID=
SURMOTORS_PAGE_ID=

# --- OpenRouter (Qwen) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ANALYST=qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL_GENERATOR=qwen/qwen-2.5-14b-instruct

# --- Spoter APIs (pull) ---
SPOTER_API_BASE=
SPOTER_INSTANCE_ID=42
SPOTER_CSRF_TOKEN=
SPOTER_BEARER=

# --- Cloudflare R2 (storage variantes) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=metasuite-variants
R2_PUBLIC_URL=

# --- Sistema ---
DRY_RUN_DEFAULT=true
BUDGET_CAP_FACTOR=0.15
DAILY_BUDGET_MAX_MOVEMENT_ARS=200000
PORT=3000
